{
  "name": "@owlic/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the Owlic public API (api.owlic.fr). Fully typed client derived from the API's OpenAPI/Zod contract — no runtime imports beyond fetch (zod is a type-level dependency), works on Node 18+, edge and serverless.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owlic-App/Typescript-SDK.git"
  },
  "homepage": "https://github.com/Owlic-App/Typescript-SDK#readme",
  "bugs": {
    "url": "https://github.com/Owlic-App/Typescript-SDK/issues"
  },
  "keywords": [
    "owlic",
    "sdk",
    "api-client",
    "typescript",
    "qualiopi",
    "formation",
    "training"
  ],
  "scripts": {
    "build": "tsup",
    "type:check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@owlic/api-contract": "*",
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
